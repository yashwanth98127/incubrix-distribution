# --- IncuBrix Distribution Connector Service: environment settings ---
# Mode
SIMULATION_MODE=true                # true = no real accounts, uses mock platforms + local Lemmy/Ghost
ENV=local                           # local | staging | production
LOG_LEVEL=INFO

# Database (defaults to local sqlite file, no external DB required)
DATABASE_URL=sqlite:///./data/incubrix.db

# Object storage (S3-compatible, MinIO in docker-compose)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=incubrix
S3_SECRET_KEY=incubrix_secret
S3_BUCKET=incubrix-distribution
S3_PUBLIC_BASE_URL=http://localhost:9000/incubrix-distribution
S3_USE_SSL=false

# Connector base URLs (point at local instances / mocks in docker-compose network)
DISCOURSE_MOCK_BASE_URL=http://mock-discourse:9101
DEVTO_MOCK_BASE_URL=http://mock-devto:9102
WEBHOOK_RECEIVER_BASE_URL=http://mock-webhook-receiver:9103
LEMMY_BASE_URL=http://lemmy:8536
GHOST_BASE_URL=http://ghost:2368

# Real credentials (only used when SIMULATION_MODE=false; never commit real values)
LEMMY_USERNAME=
LEMMY_PASSWORD=
GHOST_ADMIN_API_KEY=
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=
DEVTO_API_KEY=
WEBHOOK_SHARED_SECRET=dev_only_shared_secret_change_me

# Jobs
JOB_WORKER_POLL_SECONDS=0.5
BACKGROUND_THRESHOLD_SECONDS=2

# Certification harness
CERTIFICATION_CLEANUP_DEADLINE_SECONDS=600   # 10 minutes, per must-have #5

# AI adapters (optional, used only for Advanced "rules capture" step; mock adapter works with no key)
AI_PROVIDER=mock                    # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8080
